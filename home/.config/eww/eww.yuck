(include "modules/apps.yuck")
(include "modules/player.yuck")
(include "modules/volume.yuck")
(include "modules/stats.yuck")
(include "modules/tools.yuck")
(include "settings.yuck")

(defwindow control-panel
    :monitor 0
    :exclusive true
    :stacking "fg"
    :geometry (geometry
        :x "16px"
        :y "16px"
        :width "360px"
        :height "90%"
        :anchor "top left")
    (eventbox
        :hexpand true
        :onhoverlost `${EWW_CMD} close control-panel`
        (box
            :class "control-panel"
            :hexpand true
            :space-evenly false
            :orientation "v"
            (settings
                :valign "start")
            (scroll
                :vexpand true
                :hscroll false
                :vscroll true
                (box
                    :hexpand true
                    :vexpand true
                    :space-evenly false
                    :orientation "v"
                    (calendar)
                    (player)
                    (sysstats)))
            (apps
                :valign "end")
            (tools
                :valign "end"))))
