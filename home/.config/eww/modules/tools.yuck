(defwidget tools []
    (box
        :class "tools"
        :orientation "h"
        (_screenshot)
        (_colourpicker)
        (_submap
            :class "move"
            :name "Move"
            :icon ""
            :smap "move")
        (_submap
            :class "resize"
            :name "Resize"
            :icon ""
            :smap "resize")
        (_submap
            :class "kill"
            :name "Kill"
            :icon ""
            :smap "kill")))

(defwidget _screenshot []
    (button
        :class "screenshot"
        :tooltip "Screenshot"
        :onclick `scripts/screenshot.sh`
        (label :text "")))

(defwidget _colourpicker []
    (button
        :class "colour-picker"
        :tooltip "Colour picker"
        :onclick `hyprpicker -a &`
        (label :text "")))

(defwidget _submap [?class name icon smap]
    (button
        :class "${class}"
        :tooltip "${name}"
        :onclick `hyprctl dispatch 'hl.dsp.submap "${smap}"'`
        (label :text "${icon}")))
