#
# This file is for build packages with the LLVM toolchain. This means clang and
# clang++ for C and C++ respectively, and using the llvm-* version of the
# binutils. The LLVM linker ld.lld is also used as this is requried for
# building with LTO.
#
# The linux kernel can also be built using this file as we setup all the
# required tools and invoke the kernel make files with LLVM=1.
#
# The official Gentoo wiki provides some further information on using the LLVM
# toolchain for building packages.
#
# Wiki: https://wiki.gentoo.org/wiki/LLVM/Clang

LLVM=1

CC="clang"
CXX="clang++"
CPP="clang-cpp"
AR="llvm-ar"
NM="llvm-nm"
LD="ld.lld"
RANLIB="llvm-ranlib"
STRIP="llvm-strip"
OBJCOPY="llvm-objcopy"
OBJDUMP="llvm-objdump"
READELF="llvm-readelf"
