#  ____  _____ _____ _   _   _ _   _____
# |  _ \| ____|  ___/ \ | | | | | |_   _|
# | | | |  _| | |_ / _ \| | | | |   | |
# | |_| | |___|  _/ ___ \ |_| | |___| |
# |____/|_____|_|/_/   \_\___/|_____|_|

CONFIG_BLOCK=y
# CONFIG_SAMPLES is not set
# CONFIG_LIVEPATCH is not set
# CONFIG_SCHED_OMIT_FRAME_POINTER is not set
CONFIG_BFP_SYSCALL=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_COREDUMP=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_CGROUPS=y
CONFIG_FHANDLE=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_INOTIFY_USER=y
CONFIG_COMPAT_32BIT_TIME=y
CONFIG_NAMESPACES=y
CONFIG_USER_NS=y
CONFIG_SECCOMP=y
# CONFIG_PREEMPT_RT is not set
CONFIG_FRAME_POINTER=y
CONFIG_NLS=y
CONFIG_PROC_SYSCTL=y
CONFIG_PROC_FS=y
CONFIG_TMPFS=y
CONFIG_SYSFS=y
CONFIG_DMI_SYSFS=y
CONFIG_DEVTMMPFS=y
CONFIG_HUGETLBFS=y
CONFIG_UNIX=y
CONFIG_UNICODE=y

CONFIG_HZ=1000
CONFIG_HZ_1000=y

# === SYSCALL ===
#
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_TIMERFD=y
CONFIG_SIGNALFD=y
# CONFIG_SYSFS_SYSCALL is not set

# === COMPRESSION ===
#
# Use ZSTD instead of the other alternatives. This algorithm seems to have
# a good balance between speed and compression ration.
#
CONFIG_KERNEL_ZSTD=y
CONFIG_MODULE_COMPRESS_ZSTD=y


# === Software Drivers ===
#
# These are some small platform agnostic drivers which we can build directly
# into the kernel.
#
CONFIG_FUSE_FS=y
CONFIG_NTSYNC=y
