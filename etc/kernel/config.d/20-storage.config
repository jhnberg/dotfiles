CONFIG_BLK_DEV_BSGLIB=y
CONFIG_BLK_DEV_INITRD=y

# === DM and MD ===
#
# Build support for some of the DM and MD devices into the kernel as these are
# used by LVM2.
#
CONFIG_BLK_DEV_DM=y
# CONFIG_DM_DEBUG is not set
CONFIG_DM_SNAPSHOT=y
CONFIG_DM_ZERO=y
CONFIG_DM_UEVENT=y
CONFIG_BLK_DEV_MD=y
CONFIG_MD=y
CONFIG_MD_LINEAR=y
CONFIG_MD_BITMAP=y
# CONFIG_MD_LLBITMAP is not set
CONFIG_MD_AUTODETECT=y
CONFIG_MD_BITMAP_FILE=y
# CONFIG_MD_RAID0 is not set
CONFIG_MD_RAID1=y
# CONFIG_MD_RAID10 is not set
# CONFIG_MD_RAID456 is not set

# === NVMe ===
#
# Since NVMe has become a pretty standard storage device, we build support
# directly into the kernel. Systems without NVMe still exist but more often
# than not I anticipate that we will have NVMe available.
#
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_NVME_HWMON=y
