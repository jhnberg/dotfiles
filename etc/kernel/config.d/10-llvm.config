# | |   | | \ \ / /| |\/| |
# | |___| |__\ V / | |  | |
# |_____|_____\_/  |_|  |_|

CONFIG_CFI=y
# CONFIG_PROPELLER_CLANG is not set
# CONFIG_AUTOFDO_CLANG is not set

# === LTO ===
#
# The LLVM tooling allows us to build the kernel with Link-Time-Optimization.
# This allows for dead code elimination and function inlining across
# translation units
#
CONFIG_LTO=y
CONFIG_LTO_CLANG=y
# CONFIG_LTO_CLANG_NONE is not set
CONFIG_LTO_CLANG_THIN=y
# CONFIG_LTO_CLANG_FULL is not set
